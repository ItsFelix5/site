---
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <ClientRouter />
    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
      }
    </style>
    <script is:inline data-astro-rerun>
      if (typeof window.hue !== "number") window.hue = Math.random() * 360;
      document.documentElement.style.setProperty("--hue", window.hue);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
